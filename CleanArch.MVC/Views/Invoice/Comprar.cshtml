@model CleanArch.Aplication.ViewModels.InvoiceViewModel

@{
    ViewBag.Title = "Comprar";

}

<h3>Realizar compra</h3>

<div>
    <hr/>

    <dl class="row">

        <dt class="col-sm2">
            @Html.DisplayNameFor(Model => Model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(Model => Model.Id)
        </dd>
        <dt class="col-sm2">
            @Html.DisplayNameFor(Model => Model.CreateAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(Model => Model.CreateAt)
        </dd>
        <dt class="col-sm2">
            @Html.DisplayNameFor(Model => Model.UpdateAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(Model => Model.UpdateAt)
        </dd>


        <dt class="col-sm2">
            @Html.DisplayNameFor(Model => Model.Ammount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(Model => Model.Ammount)
        </dd>



        <dt class="col-sm2">
            @Html.DisplayNameFor(Model => Model.CustomerName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(Model => Model.CustomerName)
        </dd>

        <dt class="col-sm2">
            @Html.DisplayNameFor(Model => Model.CustomerEmail)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(Model => Model.CustomerEmail)
        </dd>
    </dl>
</div>

<div>
    <button id="show-form-btn" class="btn btn-primary">Adicionar Item</button>

    <div class="form-group">
        <label asp-for="InvoicesProducts.ProductId" class="col-md-2 control-label">Produto</label>
        <div class="col-md-10">



            @if (ViewBag.ProductsOptions != null)
            {
                @Html.DropDownList("SelectedProduct", (IEnumerable<SelectListItem>)ViewBag.ProductList, "Selecione um produto", new { @class = "form-control", @id = "productDropdown" })
                 @* @Html.DropDownListFor(model => model.ProductsOptions, (SelectList)ViewBag.ProductOptions, "Selecione um produto", new { @class = "form-control", @id = "productDropdown" }) *@
                 @foreach (var item in ViewBag.ProductsOptions as IEnumerable<SelectListItem>)
                {
                    <option value="@item.Value">@item.Text</option>
                } 
            }
            else
            {
                <p class="text-danger">Nenhum produto disponível.</p>
            }
            <span asp-validation-for="InvoicesProducts.ProductId" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="InvoicesProducts.Quantity" class="col-md-2 control-label">Quantidade</label>
        <div class="col-md-10">
            <input asp-for="InvoicesProducts.Quantity" class="form-control" />
            <span asp-validation-for="InvoicesProducts.Quantity" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.LabelFor(m => m.InvoicesProducts.SalesPrice)
            @Html.TextBoxFor(m => m.InvoicesProducts.SalesPrice, new { @class = "form-control", @id = "salesPrice", @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.InvoicesProducts.SalesPrice)
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Criar" class="btn btn-success" />
            <a asp-action="Index" class="btn btn-info">Voltar</a>
        </div>
    </div>
</div>


</div>