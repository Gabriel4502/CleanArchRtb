@model CleanArch.Aplication.ViewModels.InvoicesProductsViewModel

@{
    ViewData["Title"] = "Register new Invoice-Product";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create">
    <div class="form-horizontal">
        <hr />

        <vc:summary />


        <div class="form-group">
            <label asp-for="InvoiceId" class="col-md-2 control-label">Invoice</label>
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.InvoiceId, (SelectList)ViewBag.InvoiceOptions, new { @class = "form-control" })
                <span asp-validation-for="InvoiceId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ProductId" class="col-md-2 control-label">Product</label>
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.ProductId, (SelectList)ViewBag.ProductOptions, "Select a product", new { @class = "form-control", @id = "productDropdown" })
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Quantity" class="col-md-2 control-label">Quantity</label>
            <div class="col-md-10">
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>

       @*  <div class="form-group">
            <label asp-for="SalesPrice" class="col-md-2 control-label" type="number" step="0.01">Sales-Price</label>
            <div class="col-md-10">
                <input asp-for="SalesPrice" class="form-control" />
                <span asp-validation-for="SalesPrice" class="text-danger"></span>
            </div>
        </div> *@

        <div class="form-group">
            <div class="col-md-10">
                @Html.LabelFor(m => m.SalesPrice)
                @Html.TextBoxFor(m => m.SalesPrice, new { @class = "form-control", @id = "salesPrice", @readonly = "readonly" })
                @Html.ValidationMessageFor(m => m.SalesPrice)

            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-info">Back to List</a>
            </div>
        </div>
    </div>
</form>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        // Evento de mudança do dropdown de produtos
        $('#productDropdown').change(function () {
            var productId = $(this).val(); // Pega o valor selecionado

            if (productId) {
                $.ajax({
                    url: '/InvoicesProducts/GetSalesPrice',
                    type: 'GET',
                    data: { productId: productId },
                    success: function (response) {
                        
                        $('#salesPrice').val(response.salesPrice.toFixed(2));
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });
            } else {
                // Limpa o campo SalesPrice se nenhum produto for selecionado
                $('#salesPrice').val('');
            }
        });
    });
</script>

